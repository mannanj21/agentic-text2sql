# ============================================================
# Agentic Text-to-SQL Analytics Platform - Environment Config
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env - only .env.example is tracked.
# ============================================================

# --- Application ---
APP_ENV=development
REPLICA_ID=local

# --- App Database (Postgres with pgvector) ---
DATABASE_URL=postgresql+asyncpg://app:changeme@localhost:5432/text2sql

# --- Security ---
# Generate with: python scripts/gen_key.py
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_KEY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# --- SSRF ---
# Set to true ONLY for local Docker demo (allows connecting to private IPs)
ALLOW_PRIVATE_HOSTS=false

# --- LLM ---
# Provider: gemini | ollama | fake
LLM_PROVIDER=fake
LLM_API_KEY=CHANGE_ME_YOUR_API_KEY
FAST_MODEL=gemini-2.5-flash
STRONG_MODEL=gemini-2.5-pro
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# Used only with LLM_PROVIDER=fake for deterministic local/load-test latency.
FAKE_LLM_LATENCY_MS=0

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Agent ---
PLANNER_ENABLED=false
MAX_REPAIR_ATTEMPTS=3
MAX_RESULT_ROWS=500
STATEMENT_TIMEOUT_MS=30000
LOCK_TIMEOUT_MS=5000
HISTORY_TURNS=5

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_TABLES=15

# --- Display ---
RESULT_PREVIEW_ROWS=20

# --- Validator ---
FUNCTION_ALLOWLIST_MODE=true

# --- Rate Limiting ---
RATE_LIMIT_PER_MIN=30
LOGIN_RATE_LIMIT_PER_MIN=10

# --- Enrichment ---
ENRICHMENT_TOKEN_CAP=50000

# --- Evaluation ---
EVAL_AS_OF_DATE=
LLM_CACHE_MODE=off
